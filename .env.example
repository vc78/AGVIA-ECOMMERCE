# ============================================================
# LOKESH LINGAM WEAVER
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and populate real secrets outside Git.
# ============================================================

# 1. DATABASE CONFIGURATION (MySQL 8.0 with TLS)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lokesh_lingam_db
DB_USER=root
DB_USERNAME=root
DB_PASSWORD=change_me_db_password
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslMode=REQUIRED&serverTimezone=UTC

# 2. SPRING BOOT SERVER CONFIGURATION
PORT=8080
SERVER_PORT=8080
JAVA_TOOL_OPTIONS=-Xmx384m -Xms128m
DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# 3. AUTHENTICATION & SECURITY (JWT)
# Generate a unique >= 256-bit Base64 secret in production: openssl rand -base64 48
JWT_SECRET=replace_with_base64_256bit_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# 4. GOOGLE SIGN-IN (OAuth 2.0 Web Client ID - never commit Client Secret)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# 5. CORS CONFIGURATION (Explicit comma-separated trusted origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://agvia-ecommerce.vercel.app
FRONTEND_URL=https://agvia-ecommerce.vercel.app

# 6. INITIAL ADMINISTRATOR SEEDING
DEFAULT_ADMIN_NAME=Lokesh Lingam Weaver Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace_with_strong_admin_password

# 7. PAYMENT GATEWAY (Razorpay)
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# 8. EMAIL CONFIGURATION (SMTP for order notifications & password resets)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_email@example.com
MAIL_PASSWORD=your_smtp_app_password
MAIL_ENABLED=false
MAIL_FROM=your_smtp_email@example.com
STORE_NOTIFICATION_EMAIL=
ADMIN_EMAIL=
SUPPORT_EMAIL=

# 9. AI ASSISTANT (Admin Only - Optional)
GEMINI_API_KEY=

# 10. WHATSAPP NOTIFICATIONS (Optional Twilio Business)
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+917799349294
