# ============================================================
# AGVIA — WOMEN'S WEAR BOUTIQUE
# MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------
DB_NAME=agvia_db
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_USER=agvia_user
DB_PASSWORD=your_secure_db_password_here
DB_HOST=localhost
DB_PORT=3306
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ------------------------------------------------------------
# 2. SPRING BOOT SERVER CONFIGURATION
# ------------------------------------------------------------
SERVER_PORT=8080
DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# ------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# Generate a secure 256-bit+ Base64 encoded secret in production:
# e.g., openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVm
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------
# 4. CORS CONFIGURATION (Trusted Frontend Origins)
# Comma-separated list of allowed origins. Never use '*' with credentials.
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://agvia.vercel.app,https://your-custom-domain.com
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR SEEDING
# ------------------------------------------------------------
DEFAULT_ADMIN_NAME=AGVIA Administrator
DEFAULT_ADMIN_EMAIL=admin@agvia.com
DEFAULT_ADMIN_PASSWORD=change_this_admin_password_123

# ------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay)
# Server-authoritative order creation and signature verification
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TDnNEoRLz2m96G
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ------------------------------------------------------------
# 7. NOTIFICATIONS & SUPPORT (WhatsApp / Twilio)
# Official AGVIA Customer Care WhatsApp: +91 9032306961
# ------------------------------------------------------------
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+919032306961
TWILIO_FROM_NUMBER=+919032306961
TWILIO_VERIFY_SERVICE_SID=

# ------------------------------------------------------------
# 8. EMAIL SERVICE (Gmail SMTP / Production Mailer)
# ------------------------------------------------------------
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-store-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=support@agvia.com
AGVIA_ADMIN_EMAIL=admin@agvia.com
AGVIA_SUPPORT_EMAIL=support@agvia.com
STORE_NOTIFICATION_EMAIL=orders@agvia.com

# ------------------------------------------------------------
# 9. AI CATALOG ASSISTANT (Gemini - Admin Only)
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# 10. FRONTEND VITE ENVIRONMENT VARIABLES (Vercel / Local)
# These are exposed to the client bundle (prefixed with VITE_)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api
VITE_RAZORPAY_KEY_ID=rzp_test_TDnNEoRLz2m96G
VITE_EMAILJS_SERVICE_ID=service_agvia
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_5k3xk4j
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_mz2tfnj
VITE_EMAILJS_PUBLIC_KEY=
