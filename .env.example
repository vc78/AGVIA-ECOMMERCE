# ============================================================
# AGVIA — WOMEN'S WEAR BOUTIQUE
# MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Aiven Cloud MySQL / Local MySQL 8.0)
# ------------------------------------------------------------
# For Local Development:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=agvia_db
# DB_USER=root
# DB_PASSWORD=your_password
#
# For Production (Aiven Cloud MySQL):
DB_HOST=mysql-20386652-agvia.a.aivencloud.com
DB_PORT=14519
DB_NAME=defaultdb
DB_USER=avnadmin
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ------------------------------------------------------------
# 2. SPRING BOOT SERVER CONFIGURATION & MEMORY
# ------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
JAVA_TOOL_OPTIONS=-Xmx512m
DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# ------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# Generate a secure 256-bit+ Base64 encoded secret in production:
# e.g., openssl rand -base64 48
# ------------------------------------------------------------
JWT_SECRET=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVm
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------
# 4. CORS CONFIGURATION (Trusted Frontend Origins)
# Comma-separated list of allowed origins. Never use '*' with credentials.
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://agvia.vercel.app,https://agvia-ecommerce.vercel.app
FRONTEND_URL=https://agvia-ecommerce.vercel.app

# ------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR SEEDING
# ------------------------------------------------------------
DEFAULT_ADMIN_NAME=AGVIA Administrator
DEFAULT_ADMIN_EMAIL=admin@agvia.com
DEFAULT_ADMIN_PASSWORD=agvia@123

# ------------------------------------------------------------
# 6. PAYMENT GATEWAY (Razorpay)
# Server-authoritative order creation and signature verification
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_TDnNEoRLz2m96G
RAZORPAY_KEY_SECRET=25E7Iiv68Owji2k1dKm18quw

# ------------------------------------------------------------
# 7. EMAIL CONFIGURATION (Gmail SMTP)
# ------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=venkatbodduluri78@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_ENABLED=true
MAIL_FROM=venkatbodduluri78@gmail.com
STORE_NOTIFICATION_EMAIL=venkatbodduluri78@gmail.com
AGVIA_ADMIN_EMAIL=admin@agvia.com
AGVIA_SUPPORT_EMAIL=support@agvia.com

# ------------------------------------------------------------
# 8. AI ASSISTANT (Google Gemini API)
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------
# 9. NOTIFICATIONS & SUPPORT (WhatsApp / Twilio / SMS)
# Official AGVIA Customer Care WhatsApp: +91 9032306961
# ------------------------------------------------------------
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+919032306961
TWILIO_FROM_NUMBER=+919032306961
OTP_PROVIDER=composite
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
