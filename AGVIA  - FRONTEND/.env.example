# ============================================================
# AGVIA BOUTIQUE FRONTEND — ENVIRONMENT VARIABLES (.env.example)
# For local development: copy to .env
# For Vercel deployment: configure these in Vercel Project Settings -> Environment Variables
# ============================================================

# Backend API Base URL (must point to your live backend in production)
# Local: http://localhost:8080/api
# Production: https://api.yourdomain.com/api or https://agvia-backend.onrender.com/api
VITE_API_URL=http://localhost:8080/api

# Razorpay Key ID (Client-safe public key id)
VITE_RAZORPAY_KEY_ID=rzp_test_TDnNEoRLz2m96G

# EmailJS Configuration (Contact form & automatic receipt acknowledgements)
VITE_EMAILJS_SERVICE_ID=service_agvia
VITE_EMAILJS_CONTACT_TEMPLATE_ID=template_5k3xk4j
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=template_mz2tfnj
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
